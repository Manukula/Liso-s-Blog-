const ADMIN_PASSWORD = "2026";

/* Load saved question */
const savedQuestion = localStorage.getItem("boardQuestion");
if(savedQuestion){
    document.addEventListener("DOMContentLoaded", () => {
        const questionEl = document.getElementById("question");
        if(questionEl) questionEl.textContent = savedQuestion;
    });
}

/* Admin toggle with password */
function toggleAdmin(){

    const panel = document.getElementById("adminPanel");

    if(panel.classList.contains("show")){
        panel.classList.remove("show");
        return;
    }

    const password = prompt("Enter Admin Password:");

    if(password === ADMIN_PASSWORD){
        panel.classList.add("show");
    }else if(password !== null){
        alert("Incorrect password!");
    }
}

/* Change question */
function changeQuestion(){

    const input = document.getElementById("questionInput");
    const newQuestion = input.value.trim();

    if(!newQuestion) return;

    document.getElementById("question").textContent = newQuestion;
    localStorage.setItem("boardQuestion", newQuestion);

    input.value = "";
}

/* Post message */
function postMessage(){

    const input = document.getElementById("messageInput");
    const text = input.value.trim();

    if(!text) return;

    createNote(text);
    input.value = "";
}

/* Random color */
function getRandomColor(){
    const hue = Math.floor(Math.random() * 360);
    return `hsl(${hue}, 80%, 55%)`;
}

/* Create sticky note */
function createNote(text){

    const board = document.getElementById("board");

    const note = document.createElement("div");
    note.className = "note";
    note.style.background = getRandomColor();

    const width = board.clientWidth - 300;
    const height = board.clientHeight - 120;

    note.style.left = Math.max(10, Math.random() * width) + "px";
    note.style.top = Math.max(10, Math.random() * height) + "px";

    note.innerHTML = `
        <div>${escapeHtml(text)}</div>
        <div class="timer">30s</div>
    `;

    board.appendChild(note);

    let seconds = 500;
    const timer = note.querySelector(".timer");

    const interval = setInterval(() => {

        seconds--;
        timer.textContent = seconds + "s";

        if(seconds <= 0){
            clearInterval(interval);
            note.classList.add("fade-out");

            setTimeout(() => note.remove(), 800);
        }

    }, 1000);
}

/* Prevent HTML injection */
function escapeHtml(text){
    const div = document.createElement("div");
    div.innerText = text;
    return div.innerHTML;
}

/* Enter key support */
document.addEventListener("DOMContentLoaded", () => {
    const messageInput = document.getElementById("messageInput");
    if(messageInput){
        messageInput.addEventListener("keypress", function(e){
            if(e.key === "Enter"){
                postMessage();
            }
        });
    }
});


// 🎵 YouTube Playlist
let player;
let currentVideo = 0;

// Your playlist (your links converted to video IDs)
const playlist = [
    "f5-IY_Ja1RM",
    "IlW7QgdQfKg",
    "cYOV5i85fsw",
    "KZGWfHdfWQs",
    "f5-IY_Ja1RM",
    "h4s4VLU2RTs",
    "lNQOS-S_vTg",
    "u2ah9tWTkmk",
    "https://youtu.be/byxFUKxhT3s?list=RDbyxFUKxhT3s"

];

// Create player
function onYouTubeIframeAPIReady(){

    player = new YT.Player("player", {
        height: "360",
        width: "100%",
        videoId: playlist[currentVideo],
        playerVars: {
            autoplay: 1,
            mute: 1,
            controls: 0,
            rel: 0,
            modestbranding: 1,
            playsinline: 1
        },
        events: {
            onReady: (event) => {
                event.target.playVideo();
            },
            onStateChange: onPlayerStateChange
        }
    });
}

// Auto-play next video
function onPlayerStateChange(event){

    if(event.data === YT.PlayerState.ENDED){
        nextVideo();
    }
}

// Next video
function nextVideo(){
    if(!player) return;
    
    currentVideo++;

    if(currentVideo >= playlist.length){
        currentVideo = 0;
    }

    player.loadVideoById(playlist[currentVideo]);
}

// Previous video
function prevVideo(){
    if(!player) return;
    
    currentVideo--;

    if(currentVideo < 0){
        currentVideo = playlist.length - 1;
    }

    player.loadVideoById(playlist[currentVideo]);
}

// Mute toggle
function toggleMute(){

    if(!player) return;
    
    if(player.isMuted()){
        player.unMute();
    }else{
        player.mute();
    }
}

// Load YouTube IFrame API
const tag = document.createElement('script');
tag.src = "https://www.youtube.com/iframe_api";
const firstScriptTag = document.getElementsByTagName('script')[0];
firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

